---
import { getCollection } from "astro:content";

import Layout from "#layouts/Layout.astro";

const categories = await getCollection("categories");
---

<Layout>
    <ul>
        {categories.map((category) => (
            <li>
                <a href={`/blog/categories/${category.id}`}>
                    {category.data.name}
                </a>
            </li>
        ))}
    </ul>
</Layout>
