---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import Layout from "#layouts/Layout.astro";
import { languages } from "#/i18n/ui";
import { getLangFromUrl, useTranslations } from "#/i18n/utils";
import { Heading } from "#/components/ui/heading";
import { PostCard } from "#/components/blocks";
import { css } from "#styled-system/css";
import type { CollectionEntry } from "astro:content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export const getStaticPaths = (async ({ paginate }) => {
    const locales = Array.from(Object.keys(languages));
    const blogPosts = await getCollection("blog");
    const allTags = await getCollection("tags");

    return locales.flatMap((locale) => {
        const posts = blogPosts
            .filter(
                (post) =>
                    post.data.locale === locale &&
                    !post.data.isDraft &&
                    !!post.data.publishedAt,
            )
            .sort(
                (a, b) =>
                    b.data.updatedAt.getTime() - a.data.updatedAt.getTime(),
            );

        const taggedPosts = posts.map((post) => {
            const tags: Array<CollectionEntry<"tags">> = [];

            post.data.tags?.map((tag) => {
                allTags.map((t) => {
                    if (tag.id === t.id) tags.push(t);
                });
            });

            return {
                post,
                tags,
            };
        });

        return paginate(taggedPosts, {
            pageSize: 12,
            params: {
                locale,
            },
        });
    });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title={t("blog:title")} description={t("blog:description")}>
    <div class={css({ spaceY: "8" })}>
        <Heading as="h1" level="h1">
            {t("nav:blog")}
        </Heading>
        {page.data.length <= 0 ? (
            <p>No data</p>
        ) : (
            <div class={css({ spaceY: "2" })}>
                {page.data.map((item) => (
                    <PostCard post={item.post} tags={item.tags} />
                ))}
            </div>
        )}
    </div>
</Layout>
