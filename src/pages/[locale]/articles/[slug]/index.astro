---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntries, getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-iconset/components";

import Layout from "#layouts/Layout.astro";
import { Heading } from "#/components/ui/heading";
import { Prose } from "#/components/ui/prose";
import { Badge } from "#/components/ui/badge";
import { Button } from "#/components/ui/button";
import { Text } from "#/components/ui/text";
import { formatDate, getLangFromUrl, useTranslations } from "#/i18n/utils";
import { css, cx } from "#styled-system/css";
import { hstack, vstack } from "#styled-system/patterns";
import { prose } from "#styled-system/recipes";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export const getStaticPaths = (async () => {
    const posts = (await getCollection("blog")).filter(
        (post) => !post.data.isDraft && !!post.data.publishedAt,
    );

    return posts.map((post) => ({
        params: { locale: post.data.locale, slug: post.data.slug },
        props: { post },
    }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const tags = await getEntries(post.data.tags ?? []);
const categories = await getEntries(post.data.categories ?? []);

const translation = post.data.translation
    ? await getEntry(post.data.translation)
    : null;
const relatedPosts = await getEntries(post.data.related ?? []);
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.excerpt}>
    <div class={css({ spaceY: "8" })}>
        <div class={css({ spaceY: "2" })}>
            <Button
                as="a"
                href={getRelativeLocaleUrl(post.data.locale, "/blog/1")}
                variant="outline"
            >
                <Icon name="tabler:arrow-left" />
                {t("latest_blog")}
            </Button>
            <Heading as="h1" level="h2">
                {post.data.title}
            </Heading>
        </div>
        <div
            class={vstack({
                gap: "2",
                alignItems: "stretch",
                borderBottomWidth: "1px",
                borderColor: "border",
                pb: { smDown: "6", sm: "12" },
            })}
        >
            <Text
                class={css({
                    colorPalette: "fg",
                    fontSize: { smDown: "xl", md: "2xl" },
                    textWrap: "pretty",
                })}
                muted
            >
                {post.data.excerpt}
            </Text>
            <div
                class={hstack({
                    gap: "2",
                    flexWrap: "wrap",
                    alignItems: "safe center",
                })}
            >
                <Text
                    class={css({
                        colorPalette: "fg",
                        me: "4",
                    })}
                    muted
                >
                    {formatDate(post.data.updatedAt)}
                </Text>
                {tags.map((tag) => (
                    <Badge
                        as="a"
                        href={getRelativeLocaleUrl(
                            post.data.locale,
                            `/tags/${tag.id}/1`,
                        )}
                        variant="subtle"
                        size="lg"
                    >
                        #{tag.data.name[post.data.locale].toLocaleLowerCase()}
                    </Badge>
                ))}
            </div>
        </div>

        <article
            class={cx(
                prose({
                    size: { smDown: "md", sm: "lg" },
                }),
                css({
                    pt: { smDown: "6", sm: "12" },
                    maxW: "full",
                    "--prose-leading": "1.5",
                    "--prose-flow": "1em",
                }),
            )}
        >
            <Content />
        </article>

        {relatedPosts.length > 0 && (
            <div>
                <Heading as="h3" level="h3">
                    {t("related_posts")}
                </Heading>
            </div>
        )}
    </div>
</Layout>
