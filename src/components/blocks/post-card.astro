---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import { hstack, linkOverlay, stack } from "#styled-system/patterns";
import * as Card from "#/components/ui/card";
import { Text } from "#/components/ui/text";
import { Button } from "#/components/ui/button";
import { Badge } from "#/components/ui/badge";
import { css, cx } from "#styled-system/css";
import { formatDate, getLangFromUrl, useTranslations } from "#/i18n/utils";

interface Props {
    post: CollectionEntry<"blog">;
    tags: Array<CollectionEntry<"tags">>;
}

const { post, tags } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Card.Root>
    <Card.Body>
        <div
            class={stack({
                smDown: {
                    flexDir: "column",
                    gap: "2",
                    alignItems: "stretch",
                    justifyContent: "start",
                },
                sm: {
                    flexDir: "row",
                    gap: "4",
                    alignItems: "start",
                    justifyContent: "stretch",
                },
            })}
        >
            <Text size="sm">
                {formatDate(post.data.updatedAt, post.data.locale)}
            </Text>

            <div class={css({ flex: 1, spaceY: "2" })}>
                <Card.Title
                    class={css({
                        maxW: { smDown: "full", sm: "4xl" },
                    })}
                >
                    <a
                        href={getRelativeLocaleUrl(
                            post.data.locale,
                            `/articles/${post.data.slug}`,
                        )}
                    >
                        {post.data.title}
                    </a>
                </Card.Title>
                {tags.length > 0 && (
                    <div class={hstack({ gap: "2" })}>
                        {tags.map((tag) => (
                            <Badge
                                as="a"
                                href={getRelativeLocaleUrl(
                                    post.data.locale,
                                    `/tags/${tag.id}/1`,
                                )}
                            >
                                #{tag.data.name[lang].toLocaleLowerCase()}
                            </Badge>
                        ))}
                    </div>
                )}
            </div>

            <Button
                href={getRelativeLocaleUrl(
                    post.data.locale,
                    `/articles/${post.data.slug}`,
                )}
                as="a"
                class={cx(css({ alignSelf: "end" }))}
                variant="subtle"
            >
                {t("read_post")}
            </Button>
        </div>
    </Card.Body>
</Card.Root>
