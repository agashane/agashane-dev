---
import type { HTMLTag, Polymorphic } from "astro/types";
import { button, type ButtonVariantProps } from "#styled-system/recipes";
import { cx } from "#styled-system/css";

type Props<Tag extends HTMLTag> = {
    loading?: boolean;
} & ButtonVariantProps &
    Polymorphic<{ as: Tag }>;

const {
    variant,
    size,
    loading = false,
    class: className,
    ...attrs
} = Astro.props;
const Tag = "href" in attrs ? "a" : "button";
---

<Tag class:list={[button({ variant, size }), className]} {...attrs}>
    {loading && <span>L</span>}

    {!loading && <slot name="left-icon" />}
    <slot />
    {!loading && <slot name="right-icon" />}
</Tag>
