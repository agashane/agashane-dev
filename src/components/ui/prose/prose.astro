---
import { prose, type ProseVariantProps } from "#styled-system/recipes/prose";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article">, ProseVariantProps {}

const { size, class: className, ...attrs } = Astro.props;
---

<article class:list={[prose({ size }), className]} {...attrs}>
    <slot />
</article>
