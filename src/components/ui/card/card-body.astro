---
import type { HTMLAttributes } from "astro/types";
import { card, type CardVariantProps } from "#styled-system/recipes/card";

interface Props extends HTMLAttributes<"div">, CardVariantProps {}

const { variant, class: className, ...attrs } = Astro.props;
---

<div class:list={[card({ variant }).body, className]} {...attrs}>
    <slot />
</div>
