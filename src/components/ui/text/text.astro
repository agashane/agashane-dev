---
import type { HTMLAttributes } from "astro/types";
import { text, type TextVariantProps } from "#styled-system/recipes/text";

interface Props extends HTMLAttributes<"p">, TextVariantProps {}

const { size, weight, muted, lead, class: className, ...attrs } = Astro.props;
---

<p class:list={[text({ size, weight, muted, lead }), className]} {...attrs}>
    <slot />
</p>
