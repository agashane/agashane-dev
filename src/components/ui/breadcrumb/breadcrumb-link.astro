---
import {
    breadcrumb,
    type BreadcrumbVariantProps,
} from "#styled-system/recipes/breadcrumb";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a">, BreadcrumbVariantProps {}

const { class: className, ...attrs } = Astro.props;
---

<a
    data-slot="breadcrumb-link"
    class:list={[breadcrumb().link, className]}
    {...attrs}
>
    <slot />
</a>
