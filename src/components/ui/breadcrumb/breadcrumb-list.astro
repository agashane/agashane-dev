---
import {
    breadcrumb,
    type BreadcrumbVariantProps,
} from "#styled-system/recipes/breadcrumb";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"ol">, BreadcrumbVariantProps {}

const { class: className, ...attrs } = Astro.props;
---

<ol
    data-slot="breadcrumb-list"
    class:list={[breadcrumb().list, className]}
    {...attrs}
>
    <slot />
</ol>
