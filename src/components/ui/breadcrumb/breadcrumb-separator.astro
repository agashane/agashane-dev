---
import {
    breadcrumb,
    type BreadcrumbVariantProps,
} from "#styled-system/recipes/breadcrumb";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"li">, BreadcrumbVariantProps {}

const { class: className, ...attrs } = Astro.props;
const hasSlot = Astro.slots.has("default");
---

<li
    data-slot="breadcrumb-separator"
    class:list={[breadcrumb().separator, className]}
    {...attrs}
>
    {hasSlot ? <slot /> : "/"}
</li>
